{
  "format": "SQLite",
  "version": "1",
  "tables": {
    "metadata": {
      "columns": {
        "key": "TEXT PRIMARY KEY",
        "value": "TEXT NOT NULL"
      }
    },
    "movies": {
      "columns": {
        "movie_id": "INTEGER PRIMARY KEY",
        "title": "TEXT NOT NULL",
        "genres": "TEXT NOT NULL"
      }
    },
    "links": {
      "columns": {
        "movie_id": "INTEGER PRIMARY KEY",
        "imdb_id": "TEXT",
        "tmdb_id": "TEXT"
      },
      "indexes": ["links_imdb_id"]
    },
    "ratings": {
      "columns": {
        "user_id": "INTEGER NOT NULL",
        "movie_id": "INTEGER NOT NULL",
        "rating": "REAL NOT NULL",
        "timestamp": "INTEGER NOT NULL"
      },
      "indexes": ["ratings_movie_id", "ratings_user_timestamp"]
    },
    "tags": {
      "columns": {
        "user_id": "INTEGER NOT NULL",
        "movie_id": "INTEGER NOT NULL",
        "tag": "TEXT NOT NULL",
        "timestamp": "INTEGER NOT NULL"
      },
      "indexes": ["tags_user_id", "tags_movie_id"]
    },
    "genome_tags": {
      "optional": true,
      "columns": {
        "tag_id": "INTEGER PRIMARY KEY",
        "tag": "TEXT NOT NULL"
      }
    },
    "genome_scores": {
      "optional": true,
      "columns": {
        "movie_id": "INTEGER NOT NULL",
        "tag_id": "INTEGER NOT NULL",
        "relevance": "REAL NOT NULL"
      },
      "indexes": ["genome_scores_movie_id", "genome_scores_tag_id"]
    }
  }
}
